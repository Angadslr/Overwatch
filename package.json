{
  "name": "overwatch-native-probe",
  "displayName": "Overwatch Native Integration Probe",
  "description": "Local feasibility probe for native Cursor hook delivery. Not the supervision alpha.",
  "version": "0.0.3",
  "publisher": "angad-local",
  "private": true,
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Reports capabilities only; executable hooks require trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {"command":"overwatch.supervision.previewExport","title":"Agent Supervision: Preview Local Diagnostic Export"},
      {"command":"overwatch.supervision.saveReviewedExport","title":"Agent Supervision: Save Reviewed Local Export"},
      {"command":"overwatch.supervision.previewHistoryReset","title":"Agent Supervision: Preview Clear Owned History"},
      {"command":"overwatch.supervision.clearReviewedHistory","title":"Agent Supervision: Clear Reviewed Owned History"},
      {"command":"overwatch.supervision.cancelMaintenanceReview","title":"Agent Supervision: Cancel Diagnostic or History Review"},
      {
        "command": "overwatch.probe.enable",
        "title": "Overwatch Probe: Enable in Fixture Workspace"
      },
      {
        "command": "overwatch.probe.enableProjectHooks",
        "title": "Overwatch Probe: Enable Project Hook Fallback in Fixture Workspace"
      },
      {
        "command": "overwatch.probe.disable",
        "title": "Overwatch Probe: Disable"
      },
      {
        "command": "overwatch.probe.disableAndReload",
        "title": "Overwatch Probe: Disable and Reload Fixture Window"
      },
      {
        "command": "overwatch.probe.report",
        "title": "Overwatch Probe: Show Compatibility Report"
      },
      {
        "command": "overwatch.supervision.enable",
        "title": "Agent Supervision: Enable in Fixture Workspace"
      },
      {
        "command": "overwatch.supervision.disable",
        "title": "Agent Supervision: Disable"
      },
      {
        "command": "overwatch.supervision.disableAndReload",
        "title": "Agent Supervision: Disable and Reload Fixture Window"
      },
      {
        "command": "overwatch.supervision.refresh",
        "title": "Agent Supervision: Refresh File Activity"
      },
      {
        "command": "overwatch.supervision.openFile",
        "title": "Agent Supervision: Open Current Fixture File"
      },
      {
        "command": "overwatch.supervision.report",
        "title": "Agent Supervision: Save Collection Report"
      },
      {
        "command": "overwatch.supervision.filterActivity",
        "title": "Agent Supervision: Filter Activity",
        "icon": "$(filter)"
      },
      {
        "command": "overwatch.supervision.clearActivityFilters",
        "title": "Agent Supervision: Clear Activity Filters",
        "icon": "$(clear-all)"
      },
      {
        "command": "overwatch.supervision.freezeDisplay",
        "title": "Agent Supervision: Freeze or Resume Display",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overwatch.supervision.toggleDetailsBeside",
        "title": "Agent Supervision: Toggle File Details Beside Editor",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "overwatch.supervision.toggleFollowLatest",
        "title": "Agent Supervision: Toggle Follow Latest Activity",
        "icon": "$(arrow-down)"
      },
      {
        "command": "overwatch.supervision.inspectAttention",
        "title": "Agent Supervision: Inspect Attention Item",
        "icon": "$(info)"
      },
      {
        "command": "overwatch.supervision.acknowledgeAttention",
        "title": "Agent Supervision: Acknowledge Attention Item",
        "icon": "$(check)"
      },
      {
        "command": "overwatch.supervision.toggleMuteAttention",
        "title": "Agent Supervision: Mute or Unmute Attention Rule",
        "icon": "$(bell-slash)"
      },
      {
        "command": "overwatch.supervision.runSelfCheck",
        "title": "Agent Supervision: Run Helper and Collector Self-check",
        "icon": "$(checklist)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "overwatch-supervision",
          "title": "Agent Supervision",
          "icon": "assets/supervision.svg"
        }
      ]
    },
    "views": {
      "overwatch-supervision": [
        {
          "id": "overwatch.supervision.files",
          "name": "Conversations"
        },
        {
          "id": "overwatch.supervision.byFile",
          "name": "Files"
        },
        {
          "id": "overwatch.supervision.activity",
          "name": "Activity"
        },
        {
          "id": "overwatch.supervision.attention",
          "name": "Attention"
        },
        {
          "id": "overwatch.supervision.health",
          "name": "Source Health"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "overwatch.supervision.enable",
          "when": "view == overwatch.supervision.files",
          "group": "navigation@1"
        },
        {
          "command": "overwatch.supervision.disable",
          "when": "view == overwatch.supervision.files",
          "group": "navigation@2"
        },
        {
          "command": "overwatch.supervision.refresh",
          "when": "view == overwatch.supervision.files",
          "group": "navigation@3"
        },
        {
          "command": "overwatch.supervision.filterActivity",
          "when": "view == overwatch.supervision.activity",
          "group": "navigation@1"
        },
        {
          "command": "overwatch.supervision.clearActivityFilters",
          "when": "view == overwatch.supervision.activity",
          "group": "navigation@2"
        },
        {
          "command": "overwatch.supervision.freezeDisplay",
          "when": "view == overwatch.supervision.activity",
          "group": "navigation@3"
        },
        {
          "command": "overwatch.supervision.toggleDetailsBeside",
          "when": "view == overwatch.supervision.activity",
          "group": "navigation@4"
        },
        {
          "command": "overwatch.supervision.toggleFollowLatest",
          "when": "view == overwatch.supervision.activity",
          "group": "navigation@5"
        },
        {
          "command": "overwatch.supervision.runSelfCheck",
          "when": "view == overwatch.supervision.health",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "overwatch.supervision.inspectAttention",
          "when": "view == overwatch.supervision.attention && viewItem == overwatchAttention",
          "group": "navigation"
        },
        {
          "command": "overwatch.supervision.acknowledgeAttention",
          "when": "view == overwatch.supervision.attention && viewItem == overwatchAttention",
          "group": "inline"
        },
        {
          "command": "overwatch.supervision.toggleMuteAttention",
          "when": "view == overwatch.supervision.attention && viewItem == overwatchAttention",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Agent Supervision",
      "properties": {
        "agentSupervision.allowExistingHooks": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Allow adding observation hooks to a valid existing project hook configuration. Review .cursor/hooks.json first. Keeps an exact private backup and restores it only when the installed configuration is unchanged; existing permission hooks retain their behavior."
        },
        "agentSupervision.pathExclusions": {
          "type": "array",
          "default": [],
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "description": "Additional relative path globs excluded before collection. Changing this setting stops collection; enable again to resume."
        },
        "agentSupervision.detailsBeside": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Open read-only activity details beside the source editor; turn off to use its editor group. Applies to the next selection."
        },
        "agentSupervision.followLatest": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Scroll the Activity view to new events without moving focus or selection. Frozen display does not follow."
        },
        "agentSupervision.notifications": {
          "type": "boolean",
          "default": false,
          "description": "Show bounded local notifications for qualified high/medium overlap advisories. Reads and ordinary success stay quiet."
        }
      }
    }
  },
  "scripts": {
    "package:candidate": "node scripts/package-candidate.mjs",
    "verify:candidate": "node scripts/verify-candidate.mjs .local/overwatch-supervision-candidate-0.0.4-darwin-arm64.vsix",
    "test:candidate": "node scripts/test-candidate.mjs",
    "qualify:resources": "node scripts/qualify-resources.mjs",
    "dev:landing": "node scripts/serve-landing.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "build:helper": "node scripts/go-helper.mjs build",
    "test:helper": "node scripts/go-helper.mjs test",
    "check": "npm run check:contracts && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:integration": "npm run build && npm run build:helper && node --test tests/integration/*.test.mjs",
    "probe:launch": "npm run build && node scripts/launch-probe.mjs",
    "probe:environment": "node scripts/environment.mjs",
    "package:probe": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license --no-rewrite-relative-links --out overwatch-native-probe-0.0.3.vsix",
    "test:extension": "npm run build && npm run build:helper && node scripts/test-extension.mjs",
    "supervision:launch": "npm run build && npm run build:helper && node scripts/launch-supervision.mjs",
    "supervision:details": "node scripts/supervision-details.mjs"
  },
  "devDependencies": {
    "yauzl": "3.4.0",
    "@types/node": "22.18.10",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "jsonc-parser": "3.3.1"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
